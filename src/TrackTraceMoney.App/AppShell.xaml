<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TrackTraceMoney.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:TrackTraceMoney.App.Views"
    xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
    Title="TrackTraceMoney.App">

    <TabBar>
        <Tab Title="{x:Static resources:AppResources.Dashboard_Title}">
            <ShellContent
                Title="{x:Static resources:AppResources.Dashboard_Title}"
                ContentTemplate="{DataTemplate views:DashboardPage}"
                Route="Dashboard" />
        </Tab>
        <Tab Title="{x:Static resources:AppResources.Accounts_Title}">
            <ShellContent
                Title="{x:Static resources:AppResources.Accounts_Title}"
                ContentTemplate="{DataTemplate views:AccountsListPage}"
                Route="AccountsList" />
        </Tab>
        <Tab Title="{x:Static resources:AppResources.Credit_Title}">
            <ShellContent
                Title="{x:Static resources:AppResources.Credit_Title}"
                ContentTemplate="{DataTemplate views:CreditCardsListPage}"
                Route="CreditCardsList" />
        </Tab>
        <Tab Title="{x:Static resources:AppResources.Transactions_Title}">
            <ShellContent
                Title="{x:Static resources:AppResources.Transactions_Title}"
                ContentTemplate="{DataTemplate views:TransactionsListPage}"
                Route="TransactionsList" />
        </Tab>
        <!-- Categories/Budgets/RecurringExpenses/People deliberately have no Tab here — Android's Shell
             renderer auto-collapses tabs beyond what fits the Material BottomNavigationView into a native
             "More" BottomSheetDialog themed by the untouched Android-level Maui.SplashTheme (not this
             app's Styles.xaml/dark theme), which is how a stark white popup was reaching an otherwise
             dark-themed app. These 4 screens are occasional "manage/configure" destinations, not daily-
             driver ones, so they moved to SettingsPage.xaml buttons instead (same reachability pattern as
             Profiles/FinancialInstitutions/CardNetworks) — see SettingsViewModel's GoToManageXxx commands
             and AppShell.xaml.cs's Routing.RegisterRoute calls for each page's route now that it's pushed
             rather than a Tab's ShellContent. -->
        <Tab Title="{x:Static resources:AppResources.Settings_Title}">
            <ShellContent
                Title="{x:Static resources:AppResources.Settings_Title}"
                ContentTemplate="{DataTemplate views:SettingsPage}"
                Route="Settings" />
        </Tab>
    </TabBar>

</Shell>
