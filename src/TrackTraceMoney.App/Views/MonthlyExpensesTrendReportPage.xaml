<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:models="clr-namespace:TrackTraceMoney.App.Models"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.MonthlyExpensesTrendReportPage"
             x:DataType="viewModels:MonthlyExpensesTrendReportViewModel"
             Title="{x:Static resources:AppResources.MonthlyExpensesTrendReport_Title}">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">

                <Label Text="{x:Static resources:AppResources.NetWorth_CurrencyLabel}" />
                <Picker ItemsSource="{Binding AvailableCurrencies}"
                        SelectedItem="{Binding SelectedCurrency}" />

                <Label Text="{x:Static resources:AppResources.Reports_EmptyForCurrency}"
                       IsVisible="{Binding IsEmpty}" />

                <CollectionView ItemsSource="{Binding Rows}" SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:MonthlyTrendBarItem">
                            <Grid Padding="0,6" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding MonthLabel}"
                                       FontSize="14" TextColor="{StaticResource Gray100}" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Amount, StringFormat='{0:N2}'}"
                                       FontSize="14" TextColor="{StaticResource Gray100}" />
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" HeightRequest="10" Margin="0,4,0,0">
                                    <BoxView HeightRequest="10" CornerRadius="5"
                                             Color="{StaticResource Gray600}"
                                             WidthRequest="{x:Static models:ReportBarWidth.MaxWidth}"
                                             HorizontalOptions="Start" />
                                    <BoxView HeightRequest="10" CornerRadius="5"
                                             Color="{StaticResource Primary}"
                                             WidthRequest="{Binding BarWidthRequest}"
                                             HorizontalOptions="Start" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
