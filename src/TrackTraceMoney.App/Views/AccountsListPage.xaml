<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:models="clr-namespace:TrackTraceMoney.App.Models"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.AccountsListPage"
             x:DataType="viewModels:AccountsListViewModel"
             x:Name="Root"
             Title="{x:Static resources:AppResources.Accounts_Title}">

    <!-- ScrollView + VerticalStackLayout, not a Grid with a "*" list row: a Grid's "*" row always
         claims the full remaining screen height regardless of how many accounts exist, so a short list
         left a large empty gap between the last row and the buttons below, anchored at the very bottom
         of the screen (found via user feedback: "hay mucho espacio desperdiciado"). This mirrors the
         Reports pages' already-shipped, live-verified pattern (e.g. BudgetVsSpendingReportPage) — the
         CollectionView sizes to its own (short, non-virtualized-but-fine-at-this-scale) content inside
         the ScrollView, so the buttons sit immediately after the list instead of pinned to the bottom. -->
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadAccountsCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="8">

                <HorizontalStackLayout Spacing="8">
                    <Switch IsToggled="{Binding ShowInactive}" AutomationId="AccountsList_ShowInactiveSwitch" />
                    <Label Text="{x:Static resources:AppResources.AccountsList_ShowInactiveLabel}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label Text="{Binding ErrorMessage}" TextColor="Red" />

                <CollectionView ItemsSource="{Binding Accounts}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="24">
                            <Label Text="{x:Static resources:AppResources.Accounts_Empty}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AccountListItem">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="{x:Static resources:AppResources.AccountsList_EditAction}"
                                                   IsVisible="{Binding IsActive}"
                                                   Command="{Binding Source={x:Reference Root}, Path=BindingContext.EditAccountCommand}"
                                                   CommandParameter="{Binding Id}" />
                                        <SwipeItem Text="{x:Static resources:AppResources.AccountsList_DeactivateAction}"
                                                   IsVisible="{Binding IsActive}"
                                                   Command="{Binding Source={x:Reference Root}, Path=BindingContext.DeactivateAccountCommand}"
                                                   CommandParameter="{Binding Id}" />
                                        <SwipeItem Text="{x:Static resources:AppResources.AccountsList_DeleteAction}"
                                                   IsVisible="{Binding IsActive}"
                                                   BackgroundColor="DarkRed"
                                                   Command="{Binding Source={x:Reference Root}, Path=BindingContext.DeleteAccountCommand}"
                                                   CommandParameter="{Binding Id}" />
                                        <SwipeItem Text="{x:Static resources:AppResources.AccountsList_ReactivateAction}"
                                                   IsVisible="{Binding IsInactive}"
                                                   Command="{Binding Source={x:Reference Root}, Path=BindingContext.ReactivateAccountCommand}"
                                                   CommandParameter="{Binding Id}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Grid Padding="0,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
                                      AutomationId="{Binding Name, StringFormat='AccountsList_Item_{0}'}">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="16" />
                                    <Label Grid.Row="1" Grid.Column="0"
                                           Text="{Binding Kind, Converter={StaticResource AccountKindToLabelConverter}}"
                                           FontSize="12" Opacity="0.7" />
                                    <Label Grid.Row="2" Grid.Column="0"
                                           Text="{x:Static resources:AppResources.AccountsList_InactiveBadge}"
                                           IsVisible="{Binding IsInactive}"
                                           FontSize="12" Opacity="0.6" />
                                    <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                           VerticalOptions="Center"
                                           Text="{Binding Balance, StringFormat='{0:N2}'}" />
                                </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="{x:Static resources:AppResources.Accounts_AddButton}"
                        Command="{Binding AddAccountCommand}"
                        AutomationId="AccountsList_AddButton"
                        HorizontalOptions="Fill"
                        Margin="0,12,0,0" />

                <Button Text="{x:Static resources:AppResources.Accounts_ViewTermDepositsButton}"
                        Command="{Binding ViewTermDepositsCommand}"
                        HorizontalOptions="Fill"
                        Margin="0,8,0,0" />

                <Button Text="{x:Static resources:AppResources.Accounts_ViewInvestmentFundsButton}"
                        Command="{Binding ViewInvestmentFundsCommand}"
                        HorizontalOptions="Fill"
                        Margin="0,8,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
