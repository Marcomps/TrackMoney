<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.AddBudgetPage"
             x:DataType="viewModels:AddBudgetViewModel"
             Title="{x:Static resources:AppResources.AddBudget_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{x:Static resources:AppResources.AddBudget_CategoryLabel}" />
            <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />

            <Label Text="{x:Static resources:AppResources.AddBudget_AmountLabel}" />
            <Entry Text="{Binding AmountText}" Keyboard="Numeric" />

            <Label Text="{x:Static resources:AppResources.AddBudget_CurrencyLabel}" />
            <Picker ItemsSource="{Binding AvailableCurrencies}"
                    SelectedItem="{Binding SelectedCurrency}" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red" />

            <Button Text="{x:Static resources:AppResources.AddBudget_SaveButton}"
                    Command="{Binding SaveCommand}"
                    HorizontalOptions="Fill" />

            <Button Text="{x:Static resources:AppResources.AddBudget_CancelButton}"
                    Command="{Binding CancelCommand}"
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
