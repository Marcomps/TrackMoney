<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.RecordInvestmentValuationPage"
             x:DataType="viewModels:RecordInvestmentValuationViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{x:Static resources:AppResources.RecordInvestmentValuation_AsOfDateLabel}" />
            <DatePicker Date="{Binding AsOfDate}" />

            <Label Text="{x:Static resources:AppResources.RecordInvestmentValuation_ValueLabel}" />
            <Entry Text="{Binding ValueText}" Keyboard="Numeric" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red" />

            <Button Text="{x:Static resources:AppResources.RecordInvestmentValuation_SaveButton}"
                    Command="{Binding SaveCommand}"
                    HorizontalOptions="Fill" />

            <Button Text="{x:Static resources:AppResources.RecordInvestmentValuation_CancelButton}"
                    Command="{Binding CancelCommand}"
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
