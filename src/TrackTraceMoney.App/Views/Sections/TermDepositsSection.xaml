<?xml version="1.0" encoding="utf-8" ?>
<!-- Term deposits as a section of the Accounts tab (list only — its Add button lives in the host page's bottom button group; bound to TermDepositsListViewModel by the host page),
     so they're visible without drilling into a separate screen. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:models="clr-namespace:TrackTraceMoney.App.Models"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.Sections.TermDepositsSection"
             x:DataType="viewModels:TermDepositsListViewModel">

    <VerticalStackLayout Spacing="4">
        <Label Text="{x:Static resources:AppResources.TermDeposits_Title}"
               FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" />

        <VerticalStackLayout BindableLayout.ItemsSource="{Binding TermDeposits}">
            <BindableLayout.EmptyView>
                <Label Text="{x:Static resources:AppResources.TermDeposits_Empty}" FontSize="13" Opacity="0.7" Padding="0,4" />
            </BindableLayout.EmptyView>
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:TermDepositListItem">
                    <Grid Padding="0,10" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
                          AutomationId="{Binding Name, StringFormat='TermDepositsList_Item_{0}'}">
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="16" />
                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding InstitutionName}" FontSize="12" Opacity="0.7" />
                        <Label Grid.Row="2" Grid.Column="0"
                               Text="{Binding RateType, Converter={StaticResource TermDepositRateTypeToLabelConverter}}"
                               FontSize="12" Opacity="0.7" />
                        <Label Grid.Row="0" Grid.Column="1" VerticalOptions="Center"
                               Text="{Binding Balance, StringFormat='{0:N2}'}" />
                        <Label Grid.Row="1" Grid.Column="1" VerticalOptions="Center"
                               Text="{Binding Rate, StringFormat='{0:N2}'}" FontSize="12" Opacity="0.7" />
                        <Label Grid.Row="2" Grid.Column="1" VerticalOptions="Center"
                               Text="{Binding MaturityDate}" FontSize="12" Opacity="0.7" />
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>

</ContentView>
