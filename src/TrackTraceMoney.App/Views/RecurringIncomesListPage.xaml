<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:models="clr-namespace:TrackTraceMoney.App.Models"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.RecurringIncomesListPage"
             x:DataType="viewModels:RecurringIncomesListViewModel"
             x:Name="Root"
             Title="{x:Static resources:AppResources.RecurringIncomes_Title}">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="16">

        <Label Grid.Row="0"
               Text="{Binding ErrorMessage}"
               TextColor="Red"
               Margin="0,0,0,8" />

        <VerticalStackLayout Grid.Row="1"
                              IsVisible="{Binding HasDueRecurringIncomes}"
                              Spacing="8"
                              Margin="0,0,0,16">

            <Label Text="{x:Static resources:AppResources.RecurringIncomes_DueSectionTitle}"
                   FontAttributes="Bold"
                   FontSize="16" />

            <VerticalStackLayout Spacing="4"
                                  BindableLayout.ItemsSource="{Binding DueRecurringIncomes}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="models:DueRecurringIncomeListItem">
                    <Border Padding="12" Margin="0,4" StrokeShape="RoundRectangle 8">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="0">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding CategoryName}" />
                                        <Span Text=" · " />
                                        <Span Text="{Binding AccountName}" />
                                        <Span Text=" · " />
                                        <Span Text="{Binding Amount, StringFormat='{0:N2}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                    Text="{x:Static resources:AppResources.RecurringIncomes_ConfirmButton}"
                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.ConfirmCommand}"
                                    CommandParameter="{Binding Id}"
                                    AutomationId="{Binding Name, StringFormat='RecurringIncomes_ConfirmButton_{0}'}"
                                    VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadRecurringIncomesCommand}">
            <CollectionView ItemsSource="{Binding RecurringIncomes}"
                             SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="24">
                        <Label Text="{x:Static resources:AppResources.RecurringIncomes_Empty}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:RecurringIncomeListItem">
                        <Grid Padding="0,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="16" FontAttributes="Bold" />
                            <Label Grid.Row="1" Grid.Column="0">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding CategoryName}" />
                                        <Span Text=" · " />
                                        <Span Text="{Binding AccountName}" />
                                        <Span Text=" · " />
                                        <Span Text="{Binding Amount, StringFormat='{0:N2}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Grid.Row="2" Grid.Column="0">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Frequency, Converter={StaticResource RecurringIncomeFrequencyToLabelConverter}}" />
                                        <Span Text=" · " />
                                        <Span Text="{x:Static resources:AppResources.RecurringIncomes_NextDueLabel}" />
                                        <Span Text=" " />
                                        <Span Text="{Binding NextDueDate}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Grid.Row="3" Grid.Column="0" FontSize="12" Opacity="0.8">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{x:Static resources:AppResources.RecurringIncomes_BiweeklyEquivalentLabel}" />
                                        <Span Text=" " />
                                        <Span Text="{Binding BiweeklyEquivalent, StringFormat='{0:N2}'}" />
                                        <Span Text="  ·  " />
                                        <Span Text="{x:Static resources:AppResources.RecurringIncomes_MonthlyEquivalentLabel}" />
                                        <Span Text=" " />
                                        <Span Text="{Binding MonthlyEquivalent, StringFormat='{0:N2}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <VerticalStackLayout Grid.Row="0" Grid.RowSpan="4" Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Button Text="{x:Static resources:AppResources.RecurringIncomes_EditAmountButton}"
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.EditAmountCommand}"
                                        CommandParameter="{Binding Id}"
                                        IsVisible="{Binding IsActive}"
                                        AutomationId="{Binding Name, StringFormat='RecurringIncomes_EditAmountButton_{0}'}" />
                                <Button Text="{x:Static resources:AppResources.RecurringIncomes_DeactivateButton}"
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.DeactivateCommand}"
                                        CommandParameter="{Binding Id}"
                                        IsVisible="{Binding IsActive}" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="3"
                Text="{x:Static resources:AppResources.RecurringIncomes_AddButton}"
                Command="{Binding AddRecurringIncomeCommand}"
                AutomationId="RecurringIncomes_AddButton"
                HorizontalOptions="Fill"
                Margin="0,12,0,0" />

    </Grid>

</ContentPage>
