<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.AddCreditCardPage"
             x:DataType="viewModels:AddCreditCardViewModel"
             Title="{Binding PageTitle}">

    <Grid RowDefinitions="*,Auto" Padding="16">

        <ScrollView Grid.Row="0">
        <VerticalStackLayout Spacing="12">

            <Label Text="{x:Static resources:AppResources.AddCreditCard_NameLabel}" />
            <Entry Text="{Binding Name}" AutomationId="AddCreditCard_NameEntry" />

            <Label Text="{x:Static resources:AppResources.AddCreditCard_IssuerLabel}" />
            <Picker ItemsSource="{Binding InstitutionOptions}" SelectedItem="{Binding SelectedInstitution}"
                    AutomationId="AddCreditCard_InstitutionPicker" />
            <Label Text="{x:Static resources:AppResources.AddCreditCard_NoInstitutionsHint}"
                   IsVisible="{Binding HasNoInstitutions}"
                   TextColor="{StaticResource Tertiary}"
                   FontSize="12" />

            <Label Text="{x:Static resources:AppResources.AddCreditCard_NetworkLabel}" />
            <Picker ItemsSource="{Binding NetworkOptions}" SelectedItem="{Binding SelectedNetwork}"
                    AutomationId="AddCreditCard_NetworkPicker" />

            <Label Text="{x:Static resources:AppResources.AddCreditCard_LastFourDigitsLabel}" />
            <Entry Text="{Binding LastFourDigits}" Keyboard="Numeric" MaxLength="4" AutomationId="AddCreditCard_LastFourDigitsEntry" />

            <Label Text="{x:Static resources:AppResources.AddCreditCard_CurrencyLabel}" />
            <Picker ItemsSource="{Binding AvailableCurrencies}"
                    SelectedItem="{Binding SelectedCurrency}"
                    IsEnabled="{Binding IsCurrencyPickerEnabled}"
                    AutomationId="AddCreditCard_CurrencyPicker" />
            <Label Text="{x:Static resources:AppResources.AddCreditCard_CurrencyLockedMessage}"
                   IsVisible="{Binding IsCurrencyLockedMessageVisible}"
                   FontSize="12" Opacity="0.8" />

            <Label Text="{x:Static resources:AppResources.AddCreditCard_CreditLimitLabel}" />
            <Entry Text="{Binding CreditLimitText}" Keyboard="Numeric" AutomationId="AddCreditCard_CreditLimitEntry" />

            <VerticalStackLayout IsVisible="{Binding IsAmountOwedVisible}" Spacing="12">
                <Label Text="{x:Static resources:AppResources.AddCreditCard_AmountOwedLabel}" />
                <Entry Text="{Binding OpeningAmountOwedText}" Keyboard="Numeric" AutomationId="AddCreditCard_AmountOwedEntry" />
            </VerticalStackLayout>

            <Label Text="{x:Static resources:AppResources.AddCreditCard_AnnualInterestRateLabel}" />
            <Entry Text="{Binding AnnualInterestRateText}" Keyboard="Numeric" AutomationId="AddCreditCard_AnnualInterestRateEntry" />

            <Label Text="{x:Static resources:AppResources.AddCreditCard_MonthlyInterestRateLabel}" />
            <Entry Text="{Binding MonthlyInterestRateText}" Keyboard="Numeric" AutomationId="AddCreditCard_MonthlyInterestRateEntry" />

            <Label Text="{x:Static resources:AppResources.AddCreditCard_StatementCutOffDayLabel}" />
            <Entry Text="{Binding StatementCutOffDayText}" Keyboard="Numeric" AutomationId="AddCreditCard_StatementCutOffDayEntry" />

            <Label Text="{x:Static resources:AppResources.AddCreditCard_PaymentDueDayLabel}" />
            <Entry Text="{Binding PaymentDueDayText}" Keyboard="Numeric" AutomationId="AddCreditCard_PaymentDueDayEntry" />

            <Label Text="{x:Static resources:AppResources.AddCreditCard_NotesLabel}" />
            <Editor Text="{Binding Notes}" HeightRequest="80" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red" />

        </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Spacing="12" Margin="0,12,0,0">
            <Button Text="{x:Static resources:AppResources.AddCreditCard_SaveButton}"
                    Command="{Binding SaveCommand}"
                    AutomationId="AddCreditCard_SaveButton"
                    HorizontalOptions="Fill" />

            <Button Text="{x:Static resources:AppResources.AddCreditCard_CancelButton}"
                    Command="{Binding CancelCommand}"
                    HorizontalOptions="Fill" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
