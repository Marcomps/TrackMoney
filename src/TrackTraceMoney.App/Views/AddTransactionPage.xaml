<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:models="clr-namespace:TrackTraceMoney.App.Models"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.AddTransactionPage"
             x:DataType="viewModels:AddTransactionViewModel"
             x:Name="Root"
             Title="{Binding PageTitle}">

    <Grid RowDefinitions="*,Auto" Padding="16">

        <ScrollView Grid.Row="0">
        <VerticalStackLayout Spacing="12">

            <!-- Quick presets (Transaction Type Customization slice spec, Half B): a horizontal chip
                 row shown above the Type Picker. Tapping a chip pre-fills fields but never locks
                 them; hidden entirely in edit mode / when no active preset exists
                 (IsQuickPresetsVisible). -->
            <VerticalStackLayout IsVisible="{Binding IsQuickPresetsVisible}" Spacing="4">
                <Label Text="{x:Static resources:AppResources.AddTransaction_QuickPresetsLabel}" />
                <ScrollView Orientation="Horizontal">
                    <HorizontalStackLayout Spacing="8"
                                            BindableLayout.ItemsSource="{Binding QuickPresets}"
                                            AutomationId="AddTransaction_QuickPresetsRow">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TransactionPresetOption">
                                <Button Text="{Binding DisplayLabel}"
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.ApplyPresetCommand}"
                                        CommandParameter="{Binding .}"
                                        AutomationId="{Binding Name, StringFormat='AddTransaction_QuickPreset_{0}'}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>
            </VerticalStackLayout>

            <Label Text="{x:Static resources:AppResources.AddTransaction_TypeLabel}" />
            <Picker ItemsSource="{Binding AvailableTypes}"
                    SelectedItem="{Binding SelectedType}"
                    IsEnabled="{Binding IsTypePickerEnabled}"
                    AutomationId="AddTransaction_TypePicker">
                <Picker.ItemDisplayBinding>
                    <Binding Path="." Converter="{StaticResource TransactionTypeToLabelConverter}" />
                </Picker.ItemDisplayBinding>
            </Picker>

            <Label Text="{x:Static resources:AppResources.AddTransaction_DateLabel}" />
            <DatePicker Date="{Binding SelectedDate}" AutomationId="AddTransaction_DatePicker" />

            <Label Text="{x:Static resources:AppResources.AddTransaction_AmountLabel}" />
            <Entry Text="{Binding AmountText}" Keyboard="Numeric" AutomationId="AddTransaction_AmountEntry" />

            <VerticalStackLayout IsVisible="{Binding IsExpense}" Spacing="12">
                <Label Text="{x:Static resources:AppResources.AddTransaction_AccountLabel}" />
                <Picker ItemsSource="{Binding PaymentAccounts}" SelectedItem="{Binding SelectedAccount}"
                        AutomationId="AddTransaction_ExpenseAccountPicker" />

                <Label Text="{x:Static resources:AppResources.AddTransaction_CategoryLabel}" />
                <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                        AutomationId="AddTransaction_ExpenseCategoryPicker" />

                <!-- Placed immediately under Category, not near Payer/Beneficiary: this is optional extra
                     insurance/reimbursement tracking for the expense just categorized above, not a second,
                     competing way to categorize it (found via user feedback: the checkbox used to sit far
                     below Category and read like an alternative category choice). Hidden entirely in edit
                     mode (edit/delete slice spec §4.1/§4.2), see
                     AddTransactionViewModel.IsMedicalCheckboxVisible's doc comment. -->
                <VerticalStackLayout IsVisible="{Binding IsMedicalCheckboxVisible}" Spacing="12">
                    <HorizontalStackLayout Spacing="8">
                        <CheckBox IsChecked="{Binding IsMedicalExpense}" />
                        <Label Text="{x:Static resources:AppResources.AddTransaction_MedicalExpenseCheckbox}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout IsVisible="{Binding IsMedicalExpense}" Spacing="12">
                        <Label Text="{x:Static resources:AppResources.AddTransaction_MedicalInsuranceProviderLabel}" />
                        <Entry Text="{Binding MedicalInsuranceProvider}" />

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding HasInsuranceCoverage}" />
                            <Label Text="{x:Static resources:AppResources.AddTransaction_MedicalHasInsuranceCheckbox}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding HasInsuranceCoverage}" Spacing="12">
                            <Label Text="{x:Static resources:AppResources.AddTransaction_MedicalInsuranceCoveredLabel}" />
                            <Entry Text="{Binding MedicalInsuranceCoveredAmountText}" Keyboard="Numeric" />

                            <!-- Unchecked (default) = AddTransaction_MedicalFlowPending, checked = AddTransaction_MedicalFlowPaidDirectly.
                                 Both labels are shown together (rather than switching one Label's text via a
                                 bool-to-string converter) so the meaning of each state is always visible. -->
                            <Label Text="{x:Static resources:AppResources.AddTransaction_MedicalFlowPending}" FontSize="12" Opacity="0.7" />
                            <HorizontalStackLayout Spacing="8">
                                <CheckBox IsChecked="{Binding InsurancePaidProviderDirectly}" />
                                <Label Text="{x:Static resources:AppResources.AddTransaction_MedicalFlowPaidDirectly}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Label Text="{x:Static resources:AppResources.AddTransaction_PayerLabel}" />
                <Picker ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPayer}"
                        AutomationId="AddTransaction_PayerPicker" />

                <Label Text="{x:Static resources:AppResources.AddTransaction_BeneficiaryLabel}" />
                <Picker ItemsSource="{Binding People}" SelectedItem="{Binding SelectedBeneficiary}"
                        AutomationId="AddTransaction_BeneficiaryPicker" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsIncome}" Spacing="12">
                <Label Text="{x:Static resources:AppResources.AddTransaction_DestinationAccountLabel}" />
                <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedDestinationAccount}"
                        AutomationId="AddTransaction_IncomeDestinationAccountPicker" />

                <VerticalStackLayout IsVisible="{Binding IsIncomeCategoryAndPersonVisible}" Spacing="12">
                    <Label Text="{x:Static resources:AppResources.AddTransaction_CategoryLabel}" />
                    <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                            AutomationId="AddTransaction_IncomeCategoryPicker" />

                    <Label Text="{x:Static resources:AppResources.AddTransaction_PersonLabel}" />
                    <Picker ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}"
                            AutomationId="AddTransaction_IncomePersonPicker" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsTransfer}" Spacing="12">
                <Label Text="{x:Static resources:AppResources.AddTransaction_SourceAccountLabel}" />
                <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedSourceAccount}" />

                <Label Text="{x:Static resources:AppResources.AddTransaction_DestinationAccountLabel}" />
                <Picker ItemsSource="{Binding TransferDestinationAccounts}" SelectedItem="{Binding SelectedDestinationAccount}" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsCreditCardPayment}" Spacing="12">
                <Label Text="{x:Static resources:AppResources.AddTransaction_SourceAccountLabel}" />
                <Picker ItemsSource="{Binding NonTermDepositAccounts}" SelectedItem="{Binding SelectedCardPaymentSource}" />

                <Label Text="{x:Static resources:AppResources.AddTransaction_CardLabel}" />
                <Picker ItemsSource="{Binding CreditCardOptions}" SelectedItem="{Binding SelectedCardPaymentTarget}" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsLoanPayment}" Spacing="12">
                <Label Text="{x:Static resources:AppResources.AddTransaction_SourceAccountLabel}" />
                <Picker ItemsSource="{Binding NonTermDepositAccounts}" SelectedItem="{Binding SelectedLoanPaymentSource}" />

                <Label Text="{x:Static resources:AppResources.AddTransaction_LoanLabel}" />
                <Picker ItemsSource="{Binding LoanOptions}" SelectedItem="{Binding SelectedLoanPaymentTarget}" />

                <Label Text="{x:Static resources:AppResources.AddTransaction_NextPaymentDateLabel}" />
                <DatePicker Date="{Binding LoanNextPaymentDate}" />

                <Label Text="{x:Static resources:AppResources.AddTransaction_RequiredPaymentLabel}" />
                <Entry Text="{Binding RequiredPaymentText}" Keyboard="Numeric" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsInvestmentContribution}" Spacing="12">
                <Label Text="{x:Static resources:AppResources.AddTransaction_SourceAccountLabel}" />
                <Picker ItemsSource="{Binding NonTermDepositAccounts}" SelectedItem="{Binding SelectedInvestmentContributionSource}" />

                <Label Text="{x:Static resources:AppResources.AddTransaction_FundLabel}" />
                <Picker ItemsSource="{Binding InvestmentFundOptions}" SelectedItem="{Binding SelectedInvestmentContributionFund}" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsInvestmentWithdrawal}" Spacing="12">
                <Label Text="{x:Static resources:AppResources.AddTransaction_FundLabel}" />
                <Picker ItemsSource="{Binding InvestmentFundOptions}" SelectedItem="{Binding SelectedInvestmentWithdrawalFund}" />

                <Label Text="{x:Static resources:AppResources.AddTransaction_DestinationAccountLabel}" />
                <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedInvestmentWithdrawalDestination}" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsReimbursement}" Spacing="12">
                <Label Text="{x:Static resources:AppResources.AddTransaction_PendingExpensePickerLabel}" />
                <Picker ItemsSource="{Binding PendingReimbursableExpenses}" SelectedItem="{Binding SelectedPendingReimbursableExpense}" />

                <Label Text="{x:Static resources:AppResources.AddTransaction_DestinationAccountLabel}" />
                <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedReimbursementDestinationAccount}" />
            </VerticalStackLayout>

            <Label Text="{x:Static resources:AppResources.AddTransaction_DescriptionLabel}" />
            <Entry Text="{Binding Description}" AutomationId="AddTransaction_DescriptionEntry" />

            <Label Text="{x:Static resources:AppResources.AddTransaction_NotesLabel}" />
            <Editor Text="{Binding Notes}" HeightRequest="80" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red" />

        </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Spacing="12" Margin="0,12,0,0">
            <Button Text="{x:Static resources:AppResources.AddTransaction_SaveButton}"
                    Command="{Binding SaveCommand}"
                    AutomationId="AddTransaction_SaveButton"
                    HorizontalOptions="Fill" />

            <Button Text="{x:Static resources:AppResources.AddTransaction_CancelButton}"
                    Command="{Binding CancelCommand}"
                    HorizontalOptions="Fill" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
