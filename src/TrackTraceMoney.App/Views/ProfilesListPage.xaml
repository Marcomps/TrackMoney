<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:models="clr-namespace:TrackTraceMoney.App.Models"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.ProfilesListPage"
             x:DataType="viewModels:ProfilesListViewModel"
             x:Name="Root"
             Title="{x:Static resources:AppResources.ProfilesList_Title}">

    <Grid RowDefinitions="*,Auto,Auto" Padding="16">

        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadProfilesCommand}">
            <CollectionView ItemsSource="{Binding Profiles}"
                             SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="24">
                        <Label Text="{x:Static resources:AppResources.ProfilesList_Empty}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProfileListItem">
                        <Grid Padding="0,12" ColumnDefinitions="*,Auto,Auto"
                              AutomationId="{Binding Name, StringFormat='ProfilesList_Row_{0}'}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.SwitchProfileCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0" Text="{Binding Name}" FontSize="16" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{x:Static resources:AppResources.ProfilesList_ActiveBadge}"
                                   IsVisible="{Binding IsActive}"
                                   FontSize="12" Opacity="0.6"
                                   VerticalOptions="Center"
                                   Margin="0,0,12,0" />
                            <Button Grid.Column="2"
                                    Text="{x:Static resources:AppResources.ProfilesList_DeleteButton}"
                                    Command="{Binding Source={x:Reference Root}, Path=BindingContext.DeleteProfileCommand}"
                                    CommandParameter="{Binding .}"
                                    AutomationId="{Binding Name, StringFormat='ProfilesList_Delete_{0}'}"
                                    FontSize="12"
                                    Padding="12,4" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <VerticalStackLayout Grid.Row="1" Spacing="4" Margin="0,8,0,0">
            <Label Text="{Binding StatusMessage}" TextColor="Green" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" />
        </VerticalStackLayout>

        <Button Grid.Row="2"
                Text="{x:Static resources:AppResources.ProfilesList_AddButton}"
                Command="{Binding AddProfileCommand}"
                AutomationId="ProfilesList_AddButton"
                HorizontalOptions="Fill"
                Margin="0,12,0,0" />

    </Grid>

</ContentPage>
