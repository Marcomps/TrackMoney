<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.AddFinancialInstitutionPage"
             x:DataType="viewModels:AddFinancialInstitutionViewModel"
             Title="{x:Static resources:AppResources.AddFinancialInstitution_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{x:Static resources:AppResources.AddFinancialInstitution_NameLabel}" />
            <Entry Text="{Binding Name}"
                   Placeholder="{x:Static resources:AppResources.AddFinancialInstitution_NamePlaceholder}" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red" />

            <Button Text="{x:Static resources:AppResources.AddFinancialInstitution_SaveButton}"
                    Command="{Binding SaveCommand}"
                    HorizontalOptions="Fill" />

            <Button Text="{x:Static resources:AppResources.AddFinancialInstitution_CancelButton}"
                    Command="{Binding CancelCommand}"
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
