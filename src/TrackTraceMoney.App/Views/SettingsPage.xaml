<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.SettingsPage"
             x:DataType="viewModels:SettingsViewModel"
             Title="{x:Static resources:AppResources.Settings_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{x:Static resources:AppResources.Profiles_SectionTitle}"
                   FontSize="18"
                   FontAttributes="Bold" />

            <Label Text="{Binding ActiveProfileLabelText}" />

            <Label Text="{x:Static resources:AppResources.Profiles_LocalBackupScopeNotice}"
                   FontSize="12" Opacity="0.7" />

            <Button Text="{x:Static resources:AppResources.Profiles_ManageButton}"
                    Command="{Binding GoToManageProfilesCommand}"
                    AutomationId="Settings_ManageProfilesButton"
                    HorizontalOptions="Fill" />

            <Label Text="{x:Static resources:AppResources.AppLock_SectionTitle}"
                   FontSize="18"
                   FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="8">
                <Label Text="{x:Static resources:AppResources.AppLock_ToggleLabel}" VerticalOptions="Center" />
                <Switch IsToggled="{Binding IsAppLockEnabled}"
                        Toggled="OnAppLockToggled"
                        AutomationId="Settings_AppLockToggle" />
            </HorizontalStackLayout>

            <Label Text="{x:Static resources:AppResources.Settings_InstitutionsSectionTitle}"
                   FontSize="18"
                   FontAttributes="Bold" />

            <Button Text="{x:Static resources:AppResources.Settings_ManageFinancialInstitutionsButton}"
                    Command="{Binding GoToManageFinancialInstitutionsCommand}"
                    AutomationId="Settings_ManageFinancialInstitutionsButton"
                    HorizontalOptions="Fill" />

            <Button Text="{x:Static resources:AppResources.Settings_ManageCardNetworksButton}"
                    Command="{Binding GoToManageCardNetworksCommand}"
                    AutomationId="Settings_ManageCardNetworksButton"
                    HorizontalOptions="Fill" />

            <Label Text="{x:Static resources:AppResources.Settings_ExpenseManagementSectionTitle}"
                   FontSize="18"
                   FontAttributes="Bold" />

            <Button Text="{x:Static resources:AppResources.Settings_ManageCategoriesButton}"
                    Command="{Binding GoToManageCategoriesCommand}"
                    HorizontalOptions="Fill" />

            <Button Text="{x:Static resources:AppResources.Settings_ManageBudgetsButton}"
                    Command="{Binding GoToManageBudgetsCommand}"
                    HorizontalOptions="Fill" />

            <Button Text="{x:Static resources:AppResources.Settings_ManageRecurringExpensesButton}"
                    Command="{Binding GoToManageRecurringExpensesCommand}"
                    AutomationId="Settings_ManageRecurringExpensesButton"
                    HorizontalOptions="Fill" />

            <Label Text="{x:Static resources:AppResources.People_Title}"
                   FontSize="18"
                   FontAttributes="Bold" />

            <Button Text="{x:Static resources:AppResources.Settings_ManagePeopleButton}"
                    Command="{Binding GoToManagePeopleCommand}"
                    AutomationId="Settings_ManagePeopleButton"
                    HorizontalOptions="Fill" />

            <Label Text="{x:Static resources:AppResources.Settings_ReportsSectionTitle}"
                   FontSize="18"
                   FontAttributes="Bold" />

            <Button Text="{x:Static resources:AppResources.Settings_ManageReportsButton}"
                    Command="{Binding GoToManageReportsCommand}"
                    AutomationId="Settings_ManageReportsButton"
                    HorizontalOptions="Fill" />

            <Label Text="{x:Static resources:AppResources.Settings_BackupSectionTitle}"
                   FontSize="18"
                   FontAttributes="Bold" />

            <Button Text="{x:Static resources:AppResources.Settings_ExportButton}"
                    Command="{Binding ExportCommand}"
                    HorizontalOptions="Fill" />

            <Button Text="{x:Static resources:AppResources.Settings_RestoreButton}"
                    Command="{Binding RestoreCommand}"
                    HorizontalOptions="Fill" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label Text="{Binding StatusMessage}" TextColor="Green" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" />

            <Label Text="{x:Static resources:AppResources.CloudAccount_SectionTitle}"
                   FontSize="18"
                   FontAttributes="Bold" />

            <Label Text="{x:Static resources:AppResources.Profiles_CloudSharedNotice}"
                   FontSize="12" Opacity="0.7" />

            <VerticalStackLayout IsVisible="{Binding IsCloudUnauthenticated}" Spacing="12">
                <Button Text="{x:Static resources:AppResources.CloudAccount_LoginButton}"
                        Command="{Binding GoToCloudLoginCommand}"
                        HorizontalOptions="Fill" />

                <Button Text="{x:Static resources:AppResources.CloudAccount_RegisterButton}"
                        Command="{Binding GoToCloudRegisterCommand}"
                        HorizontalOptions="Fill" />
            </VerticalStackLayout>

            <VerticalStackLayout IsVisible="{Binding IsCloudAuthenticated}" Spacing="12">
                <Label Text="{Binding CloudAccountStatusText}" />

                <Label Text="{x:Static resources:AppResources.CloudBackup_SectionTitle}"
                       FontSize="18"
                       FontAttributes="Bold" />

                <Label Text="{Binding LastCloudBackupText}" />

                <Button Text="{x:Static resources:AppResources.CloudBackup_BackupButton}"
                        Command="{Binding BackupToCloudCommand}"
                        IsEnabled="{Binding CanTriggerCloudBackupOperation}"
                        HorizontalOptions="Fill" />

                <Button Text="{x:Static resources:AppResources.CloudBackup_RestoreButton}"
                        Command="{Binding RestoreFromCloudCommand}"
                        IsEnabled="{Binding CanRestoreFromCloud}"
                        HorizontalOptions="Fill" />

                <ActivityIndicator IsRunning="{Binding CloudBackupIsBusy}" IsVisible="{Binding CloudBackupIsBusy}" />

                <Label Text="{Binding CloudBackupStatusMessage}" TextColor="Green" />
                <Label Text="{Binding CloudBackupErrorMessage}" TextColor="Red" />

                <Button Text="{x:Static resources:AppResources.CloudAccount_LogoutButton}"
                        Command="{Binding CloudLogoutCommand}"
                        HorizontalOptions="Fill" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
