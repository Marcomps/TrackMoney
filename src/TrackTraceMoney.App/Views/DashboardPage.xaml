<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:models="clr-namespace:TrackTraceMoney.App.Models"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.DashboardPage"
             x:DataType="viewModels:DashboardViewModel"
             x:Name="Root"
             Title="{x:Static resources:AppResources.Dashboard_Title}">

    <RefreshView IsRefreshing="{Binding IsBusy}"
                 Command="{Binding LoadDashboardCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="18">

                <!-- Quick action: the single most common thing a user does, surfaced at the very top
                     rather than requiring a trip to the Transactions tab first. -->
                <Button Text="{x:Static resources:AppResources.Transactions_AddButton}"
                        Command="{Binding GoToAddTransactionCommand}"
                        AutomationId="Dashboard_AddTransactionButton"
                        HorizontalOptions="Fill" />

                <!-- Tile 4: financial health indicator -->
                <Border Style="{StaticResource GlossyCardStyle}" Padding="20,18">
                    <VerticalStackLayout Spacing="4" AutomationId="Dashboard_HealthTile">
                        <Label FontSize="40" HorizontalOptions="Center" Text="{Binding HealthEmoji}" />
                        <Label FontSize="16" HorizontalOptions="Center" Text="{Binding HealthLabel}"
                               AutomationId="Dashboard_HealthLabel"
                               TextColor="{StaticResource Gray100}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Tile 1: available balance per currency -->
                <Border Style="{StaticResource GlossyCardStyle}" Padding="20,18">
                    <VerticalStackLayout Spacing="8">
                        <Label FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                               Text="{x:Static resources:AppResources.Dashboard_BalanceSectionTitle}" />
                        <CollectionView ItemsSource="{Binding Balances}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CurrencyBalance">
                                    <Grid ColumnDefinitions="Auto,*" Padding="0,4">
                                        <Label Grid.Column="0" Text="{Binding Currency}" FontSize="16" TextColor="{StaticResource Gray100}" />
                                        <Label Grid.Column="1" HorizontalOptions="End" FontAttributes="Bold"
                                               Text="{Binding Total, StringFormat='{0:N2}'}" FontSize="20" TextColor="{StaticResource Primary}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Net worth tile (README §24): sum of ALL active FinancialAccount balances minus active
                     CreditAccount debt, per currency — never blended across currencies, never derived from
                     CountsAsAvailableBalance (unlike Tile 1 above). -->
                <Border Style="{StaticResource GlossyCardStyle}" Padding="20,18">
                    <VerticalStackLayout Spacing="8">
                        <Label FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                               Text="{x:Static resources:AppResources.Dashboard_NetWorthSectionTitle}" />
                        <CollectionView ItemsSource="{Binding NetWorthByCurrency}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:NetWorthTileItem">
                                    <VerticalStackLayout Spacing="4" Padding="0,4">
                                        <Label Text="{Binding Currency}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Gray100}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{x:Static resources:AppResources.Dashboard_AssetsLabel}" FontSize="16" TextColor="{StaticResource Gray200}" />
                                            <Label Grid.Column="1" Text="{Binding TotalAssets, StringFormat='{0:N2}'}" FontSize="16" TextColor="{StaticResource Gray100}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{x:Static resources:AppResources.Dashboard_LiabilitiesLabel}" FontSize="16" TextColor="{StaticResource Gray200}" />
                                            <Label Grid.Column="1" Text="{Binding TotalLiabilities, StringFormat='{0:N2}'}" FontSize="16" TextColor="{StaticResource Gray100}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{x:Static resources:AppResources.Dashboard_NetWorthLabel}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource White}" />
                                            <Label Grid.Column="1" Text="{Binding NetWorth, StringFormat='{0:N2}'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Button Text="{x:Static resources:AppResources.Dashboard_NetWorthViewHistoryButton}"
                                Command="{Binding GoToNetWorthHistoryCommand}"
                                HorizontalOptions="Fill" />
                    </VerticalStackLayout>
                </Border>

                <!-- Tile 2: income / expenses / available this month — one block per currency, never blended -->
                <Border Style="{StaticResource GlossyCardStyle}" Padding="20,18">
                    <VerticalStackLayout Spacing="8">
                        <Label FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                               Text="{x:Static resources:AppResources.Dashboard_ThisMonthSectionTitle}" />
                        <CollectionView ItemsSource="{Binding IncomeExpenseSummaries}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CurrencyIncomeExpense">
                                    <VerticalStackLayout Spacing="4" Padding="0,4">
                                        <Label Text="{Binding Currency}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Gray100}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{x:Static resources:AppResources.Dashboard_IncomeLabel}" FontSize="16" TextColor="{StaticResource Gray200}" />
                                            <Label Grid.Column="1" Text="{Binding Income, StringFormat='{0:N2}'}" FontSize="16" TextColor="{StaticResource Primary}"
                                                   AutomationId="Dashboard_IncomeAmount" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{x:Static resources:AppResources.Dashboard_ExpensesLabel}" FontSize="16" TextColor="{StaticResource Gray200}" />
                                            <Label Grid.Column="1" Text="{Binding Expenses, StringFormat='{0:N2}'}" FontSize="16" TextColor="{StaticResource Tertiary}"
                                                   AutomationId="Dashboard_ExpensesAmount" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{x:Static resources:AppResources.Dashboard_AvailableLabel}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource White}" />
                                            <Label Grid.Column="1" Text="{Binding Available, StringFormat='{0:N2}'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                                                   AutomationId="Dashboard_AvailableAmount" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Projection tile: real surplus through the end of this quincena / this month PLUS recurring
                     income expected by then. Kept separate from the income-free Real surplus tile below —
                     expected income is a projection, not available balance, until it's confirmed. -->
                <Border Style="{StaticResource GlossyCardStyle}" Padding="20,18">
                    <VerticalStackLayout Spacing="8">
                        <Label FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                               Text="{x:Static resources:AppResources.Dashboard_ProjectionSectionTitle}" />
                        <Label FontSize="13" TextColor="{StaticResource Gray200}"
                               Text="{x:Static resources:AppResources.Dashboard_ProjectionHint}" />
                        <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Projections}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ProjectionTileItem">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16" RowSpacing="4"
                                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Currency}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Gray100}" />
                                        <Label Grid.Row="0" Grid.Column="1" HorizontalOptions="End" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Gray100}"
                                               Text="{x:Static resources:AppResources.Dashboard_ProjectionHalfMonthHeader}" />
                                        <Label Grid.Row="0" Grid.Column="2" HorizontalOptions="End" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource Gray100}"
                                               Text="{x:Static resources:AppResources.Dashboard_ProjectionMonthHeader}" />
                                        <Label Grid.Row="1" Grid.Column="1" HorizontalOptions="End" FontSize="12" TextColor="{StaticResource Gray200}"
                                               Text="{Binding Source={x:Reference Root}, Path=BindingContext.HalfMonthThroughText}" />
                                        <Label Grid.Row="1" Grid.Column="2" HorizontalOptions="End" FontSize="12" TextColor="{StaticResource Gray200}"
                                               Text="{Binding Source={x:Reference Root}, Path=BindingContext.MonthThroughText}" />

                                        <Label Grid.Row="2" Grid.Column="0" FontSize="14" TextColor="{StaticResource Gray200}" Text="{x:Static resources:AppResources.Dashboard_ProjectionBalanceLabel}" />
                                        <Label Grid.Row="2" Grid.Column="1" HorizontalOptions="End" FontSize="14" TextColor="{StaticResource Gray100}" Text="{Binding HalfMonth.AvailableBalance, StringFormat='{0:N2}'}" />
                                        <Label Grid.Row="2" Grid.Column="2" HorizontalOptions="End" FontSize="14" TextColor="{StaticResource Gray100}" Text="{Binding Month.AvailableBalance, StringFormat='{0:N2}'}" />

                                        <Label Grid.Row="3" Grid.Column="0" FontSize="14" TextColor="{StaticResource Gray200}" Text="{x:Static resources:AppResources.Dashboard_ProjectionExpectedIncomeLabel}" />
                                        <Label Grid.Row="3" Grid.Column="1" HorizontalOptions="End" FontSize="14" TextColor="{StaticResource Primary}" Text="{Binding HalfMonth.ExpectedIncome, StringFormat='{0:N2}'}"
                                               AutomationId="{Binding Currency, StringFormat='Dashboard_ProjectionHalfMonthIncome_{0}'}" />
                                        <Label Grid.Row="3" Grid.Column="2" HorizontalOptions="End" FontSize="14" TextColor="{StaticResource Primary}" Text="{Binding Month.ExpectedIncome, StringFormat='{0:N2}'}"
                                               AutomationId="{Binding Currency, StringFormat='Dashboard_ProjectionMonthIncome_{0}'}" />

                                        <Label Grid.Row="4" Grid.Column="0" FontSize="14" TextColor="{StaticResource Gray200}" Text="{x:Static resources:AppResources.Dashboard_ProjectionUpcomingExpensesLabel}" />
                                        <Label Grid.Row="4" Grid.Column="1" HorizontalOptions="End" FontSize="14" TextColor="{StaticResource Tertiary}" Text="{Binding HalfMonth.UpcomingExpenses, StringFormat='{0:N2}'}"
                                               AutomationId="{Binding Currency, StringFormat='Dashboard_ProjectionHalfMonthExpenses_{0}'}" />
                                        <Label Grid.Row="4" Grid.Column="2" HorizontalOptions="End" FontSize="14" TextColor="{StaticResource Tertiary}" Text="{Binding Month.UpcomingExpenses, StringFormat='{0:N2}'}"
                                               AutomationId="{Binding Currency, StringFormat='Dashboard_ProjectionMonthExpenses_{0}'}" />

                                        <Label Grid.Row="5" Grid.Column="0" FontSize="14" TextColor="{StaticResource Gray200}" Text="{x:Static resources:AppResources.Dashboard_ProjectionDebtPaymentsLabel}" />
                                        <Label Grid.Row="5" Grid.Column="1" HorizontalOptions="End" FontSize="14" TextColor="{StaticResource Tertiary}" Text="{Binding HalfMonth.DebtPayments, StringFormat='{0:N2}'}" />
                                        <Label Grid.Row="5" Grid.Column="2" HorizontalOptions="End" FontSize="14" TextColor="{StaticResource Tertiary}" Text="{Binding Month.DebtPayments, StringFormat='{0:N2}'}" />

                                        <Label Grid.Row="6" Grid.Column="0" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource White}" Text="{x:Static resources:AppResources.Dashboard_ProjectionResultLabel}" />
                                        <Label Grid.Row="6" Grid.Column="1" HorizontalOptions="End" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" Text="{Binding HalfMonth.Projected, StringFormat='{0:N2}'}"
                                               AutomationId="{Binding Currency, StringFormat='Dashboard_ProjectionHalfMonthResult_{0}'}" />
                                        <Label Grid.Row="6" Grid.Column="2" HorizontalOptions="End" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" Text="{Binding Month.Projected, StringFormat='{0:N2}'}"
                                               AutomationId="{Binding Currency, StringFormat='Dashboard_ProjectionMonthResult_{0}'}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Upcoming income: each recurring income's next payday this month, with "I got paid" once it
                     can be confirmed (due, or up to the early-confirmation window ahead of its date). -->
                <Border Style="{StaticResource GlossyCardStyle}" Padding="20,18">
                    <VerticalStackLayout Spacing="8">
                        <Label FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                               Text="{x:Static resources:AppResources.Dashboard_UpcomingIncomesSectionTitle}" />
                        <Label Text="{x:Static resources:AppResources.Dashboard_UpcomingIncomesEmpty}"
                               TextColor="{StaticResource Gray200}"
                               IsVisible="{Binding ShowUpcomingIncomesEmpty}" />
                        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding UpcomingIncomes}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:UpcomingIncomeItem">
                                    <Grid Padding="0,4" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="16" TextColor="{StaticResource Gray100}" />
                                        <Label Grid.Row="1" Grid.Column="0" FontSize="14" TextColor="{StaticResource Gray200}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Date}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding Amount, StringFormat='{0:N2}'}" TextColor="{StaticResource Primary}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" VerticalOptions="Center"
                                                Text="{x:Static resources:AppResources.Dashboard_ConfirmIncomeButton}"
                                                IsVisible="{Binding CanConfirm}"
                                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.ConfirmIncomeCommand}"
                                                CommandParameter="{Binding .}"
                                                AutomationId="{Binding Name, StringFormat='Dashboard_ConfirmIncomeButton_{0}'}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Tile 3: over-budget categories this month -->
                <Border Style="{StaticResource GlossyCardStyle}" Padding="20,18">
                    <VerticalStackLayout Spacing="8">
                        <Label FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                               Text="{x:Static resources:AppResources.Dashboard_OverBudgetSectionTitle}" />
                        <Label Text="{x:Static resources:AppResources.Dashboard_OverBudgetEmpty}"
                               TextColor="{StaticResource Gray200}"
                               IsVisible="{Binding ShowOverBudgetEmpty}" />
                        <CollectionView ItemsSource="{Binding OverBudgetCategories}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:BudgetListItem">
                                    <Grid Padding="0,4" ColumnDefinitions="Auto,*,Auto">
                                        <Label Grid.Column="0" Text="{Binding SemaforoEmoji}" FontSize="16" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding CategoryName}" FontSize="16" TextColor="{StaticResource Gray100}"
                                               Margin="8,0,0,0" VerticalOptions="Center" />
                                        <Label Grid.Column="2" VerticalOptions="Center" TextColor="{StaticResource Gray100}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Spent, StringFormat='{0:N2}'}" />
                                                    <Span Text=" / " />
                                                    <Span Text="{Binding BudgetAmount, StringFormat='{0:N2}'}" />
                                                    <Span Text=" " />
                                                    <Span Text="{Binding Currency}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- Tile 5: upcoming payments — recurring expenses due now or within the next 7 days -->
                <Border Style="{StaticResource GlossyCardStyle}" Padding="20,18">
                    <VerticalStackLayout Spacing="8">
                        <Label FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                               Text="{x:Static resources:AppResources.Dashboard_UpcomingPaymentsSectionTitle}" />
                        <Label Text="{x:Static resources:AppResources.Dashboard_UpcomingPaymentsEmpty}"
                               TextColor="{StaticResource Gray200}"
                               IsVisible="{Binding ShowUpcomingPaymentsEmpty}" />
                        <CollectionView ItemsSource="{Binding UpcomingPayments}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:RecurringExpenseListItem">
                                    <Grid Padding="0,4" ColumnDefinitions="*,Auto,Auto">
                                        <Label Grid.Column="0" Text="{Binding Name}" FontSize="16" TextColor="{StaticResource Gray100}" />
                                        <Label Grid.Column="1" HorizontalOptions="End" Margin="8,0"
                                               Text="{Binding Amount, StringFormat='{0:N2}'}" FontSize="16" TextColor="{StaticResource Tertiary}" />
                                        <Label Grid.Column="2" HorizontalOptions="End"
                                               Text="{Binding NextDueDate}" FontSize="16" TextColor="{StaticResource Gray200}" />
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                        <Button Text="{x:Static resources:AppResources.Dashboard_UpcomingPaymentsGoToButton}"
                                Command="{Binding GoToRecurringExpensesCommand}"
                                IsVisible="{Binding HasUpcomingPayments}"
                                HorizontalOptions="Fill" />
                    </VerticalStackLayout>
                </Border>

                <!-- Real surplus tile (README §35): Tile 1's available balance minus known upcoming
                     recurring expenses (through the end of the current calendar month, wider than Tile
                     5's 7-day window above) minus debt payments (active loans' required payments + active
                     cards' remaining minimums this cycle), per currency — never blended across currencies. -->
                <Border Style="{StaticResource GlossyCardStyle}" Padding="20,18">
                    <VerticalStackLayout Spacing="8">
                        <Label FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                               Text="{x:Static resources:AppResources.Dashboard_RealSurplusSectionTitle}" />
                        <CollectionView ItemsSource="{Binding RealSurplusByCurrency}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:RealSurplusTileItem">
                                    <VerticalStackLayout Spacing="4" Padding="0,4">
                                        <Label Text="{Binding Currency}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Gray100}" />
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{x:Static resources:AppResources.Dashboard_RealSurplusBalanceLabel}" FontSize="16" TextColor="{StaticResource Gray200}" />
                                            <Label Grid.Column="1" Text="{Binding AvailableBalance, StringFormat='{0:N2}'}" FontSize="16" TextColor="{StaticResource Gray100}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{x:Static resources:AppResources.Dashboard_RealSurplusUpcomingExpensesLabel}" FontSize="16" TextColor="{StaticResource Gray200}" />
                                            <Label Grid.Column="1" Text="{Binding UpcomingExpenses, StringFormat='{0:N2}'}" FontSize="16" TextColor="{StaticResource Gray100}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{x:Static resources:AppResources.Dashboard_RealSurplusDebtPaymentsLabel}" FontSize="16" TextColor="{StaticResource Gray200}" />
                                            <Label Grid.Column="1" Text="{Binding DebtPayments, StringFormat='{0:N2}'}" FontSize="16" TextColor="{StaticResource Gray100}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{x:Static resources:AppResources.Dashboard_RealSurplusResultLabel}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource White}" />
                                            <Label Grid.Column="1" Text="{Binding Amount, StringFormat='{0:N2}'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
