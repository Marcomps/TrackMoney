<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:models="clr-namespace:TrackTraceMoney.App.Models"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.TransactionsListPage"
             x:DataType="viewModels:TransactionsListViewModel"
             Title="{x:Static resources:AppResources.Transactions_Title}">

    <!-- ScrollView + VerticalStackLayout, not a Grid with a "*" list row: see AccountsListPage.xaml's
         identical remark for why (same user-reported wasted-space issue, same fix, same precedent). -->
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadTransactionsCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="8">

                <CollectionView ItemsSource="{Binding Transactions}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="24">
                            <Label Text="{x:Static resources:AppResources.Transactions_Empty}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TransactionListItem">
                            <Grid Padding="0,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto"
                                  AutomationId="{Binding Description, StringFormat='TransactionsList_Item_{0}'}">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding AccountLabel}" FontSize="16" />
                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{Binding Description}"
                                       FontSize="12" Opacity="0.7" />
                                <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                       VerticalOptions="Center"
                                       Text="{Binding Amount, StringFormat='{0:N2}'}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="{x:Static resources:AppResources.Transactions_AddButton}"
                        Command="{Binding AddTransactionCommand}"
                        AutomationId="TransactionsList_AddButton"
                        HorizontalOptions="Fill"
                        Margin="0,12,0,0" />

                <Button Text="{x:Static resources:AppResources.Transactions_ViewHistoryButton}"
                        Command="{Binding ViewHistoryCommand}"
                        AutomationId="Transactions_ViewHistoryButton"
                        HorizontalOptions="Fill"
                        Margin="0,8,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
