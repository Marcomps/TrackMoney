<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:models="clr-namespace:TrackTraceMoney.App.Models"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.TransactionsListPage"
             x:DataType="viewModels:TransactionsListViewModel"
             Title="{x:Static resources:AppResources.Transactions_Title}">

    <Grid RowDefinitions="*,Auto,Auto" Padding="16">

        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadTransactionsCommand}">
            <CollectionView ItemsSource="{Binding Transactions}"
                             SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="24">
                        <Label Text="{x:Static resources:AppResources.Transactions_Empty}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TransactionListItem">
                        <Grid Padding="0,12" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding AccountLabel}" FontSize="16" />
                            <Label Grid.Row="1" Grid.Column="0"
                                   Text="{Binding Description}"
                                   FontSize="12" Opacity="0.7" />
                            <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                   VerticalOptions="Center"
                                   Text="{Binding Amount, StringFormat='{0:N2}'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="1"
                Text="{x:Static resources:AppResources.Transactions_AddButton}"
                Command="{Binding AddTransactionCommand}"
                HorizontalOptions="Fill"
                Margin="0,12,0,0" />

        <Button Grid.Row="2"
                Text="{x:Static resources:AppResources.Transactions_ViewHistoryButton}"
                Command="{Binding ViewHistoryCommand}"
                HorizontalOptions="Fill"
                Margin="0,8,0,0" />

    </Grid>

</ContentPage>
