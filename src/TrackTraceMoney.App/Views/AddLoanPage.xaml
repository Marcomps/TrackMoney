<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.AddLoanPage"
             x:DataType="viewModels:AddLoanViewModel"
             Title="{x:Static resources:AppResources.AddLoan_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{x:Static resources:AppResources.AddLoan_NameLabel}" />
            <Entry Text="{Binding Name}" />

            <Label Text="{x:Static resources:AppResources.AddLoan_InstitutionLabel}" />
            <Entry Text="{Binding Institution}" />

            <Label Text="{x:Static resources:AppResources.AddLoan_KindLabel}" />
            <Picker ItemsSource="{Binding AvailableKinds}"
                    SelectedItem="{Binding SelectedKind}">
                <Picker.ItemDisplayBinding>
                    <Binding Path="." Converter="{StaticResource LoanKindToLabelConverter}" />
                </Picker.ItemDisplayBinding>
            </Picker>

            <Label Text="{x:Static resources:AppResources.AddLoan_CurrencyLabel}" />
            <Picker ItemsSource="{Binding AvailableCurrencies}"
                    SelectedItem="{Binding SelectedCurrency}" />

            <Label Text="{x:Static resources:AppResources.AddLoan_OriginalAmountLabel}" />
            <Entry Text="{Binding OriginalAmountText}" Keyboard="Numeric" />

            <Label Text="{x:Static resources:AppResources.AddLoan_CurrentBalanceLabel}" />
            <Entry Text="{Binding CurrentBalanceText}" Keyboard="Numeric" />

            <Label Text="{x:Static resources:AppResources.AddLoan_InterestRateLabel}" />
            <Entry Text="{Binding InterestRateText}" Keyboard="Numeric" />

            <Label Text="{x:Static resources:AppResources.AddLoan_RateTypeLabel}" />
            <Picker ItemsSource="{Binding AvailableRateTypes}"
                    SelectedItem="{Binding SelectedRateType}">
                <Picker.ItemDisplayBinding>
                    <Binding Path="." Converter="{StaticResource LoanRateTypeToLabelConverter}" />
                </Picker.ItemDisplayBinding>
            </Picker>

            <Label Text="{x:Static resources:AppResources.AddLoan_MonthlyInstallmentLabel}" />
            <Entry Text="{Binding MonthlyInstallmentText}" Keyboard="Numeric" />

            <Label Text="{x:Static resources:AppResources.AddLoan_NextPaymentDateLabel}" />
            <DatePicker Date="{Binding NextPaymentDate}" />

            <Label Text="{x:Static resources:AppResources.AddLoan_RequiredPaymentLabel}" />
            <Entry Text="{Binding RequiredPaymentText}" Keyboard="Numeric" />

            <Label Text="{x:Static resources:AppResources.AddLoan_FeesLabel}" />
            <Entry Text="{Binding FeesText}" Keyboard="Numeric" />

            <Label Text="{x:Static resources:AppResources.AddLoan_NotesLabel}" />
            <Editor Text="{Binding Notes}" HeightRequest="80" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red" />

            <Button Text="{x:Static resources:AppResources.AddLoan_SaveButton}"
                    Command="{Binding SaveCommand}"
                    HorizontalOptions="Fill" />

            <Button Text="{x:Static resources:AppResources.AddLoan_CancelButton}"
                    Command="{Binding CancelCommand}"
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
