<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.TransactionDetailPage"
             x:DataType="viewModels:TransactionDetailViewModel"
             Title="{x:Static resources:AppResources.TransactionDetail_Title}">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">

                <Label Text="{x:Static resources:AppResources.TransactionDetail_DateLabel}" FontAttributes="Bold" />
                <Label Text="{Binding Date}" />

                <Label Text="{x:Static resources:AppResources.TransactionDetail_AmountLabel}" FontAttributes="Bold" />
                <Label Text="{Binding Amount, StringFormat='{0:N2}'}" FontSize="16" />

                <Label Text="{x:Static resources:AppResources.TransactionDetail_AccountLabel}" FontAttributes="Bold" />
                <Label Text="{Binding AccountLabel}" />

                <VerticalStackLayout IsVisible="{Binding HasCategoryName}" Spacing="4">
                    <Label Text="{x:Static resources:AppResources.TransactionDetail_CategoryLabel}" FontAttributes="Bold" />
                    <Label Text="{Binding CategoryName}" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsExpense}" Spacing="4">
                    <Label Text="{x:Static resources:AppResources.TransactionDetail_PayerLabel}" FontAttributes="Bold" />
                    <Label Text="{Binding PayerName}" />
                    <Label Text="{x:Static resources:AppResources.TransactionDetail_BeneficiaryLabel}" FontAttributes="Bold" />
                    <Label Text="{Binding BeneficiaryName}" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding IsIncome}" Spacing="4">
                    <Label Text="{x:Static resources:AppResources.TransactionDetail_PersonLabel}" FontAttributes="Bold" />
                    <Label Text="{Binding PersonName}" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding HasDescription}" Spacing="4">
                    <Label Text="{x:Static resources:AppResources.TransactionDetail_DescriptionLabel}" FontAttributes="Bold" />
                    <Label Text="{Binding Description}" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding HasNotes}" Spacing="4">
                    <Label Text="{x:Static resources:AppResources.TransactionDetail_NotesLabel}" FontAttributes="Bold" />
                    <Label Text="{Binding Notes}" />
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}" TextColor="Red" />

                <Button Text="{x:Static resources:AppResources.TransactionDetail_EditButton}"
                        Command="{Binding EditCommand}"
                        IsVisible="{Binding CanEditOrDelete}"
                        AutomationId="TransactionDetail_EditButton"
                        HorizontalOptions="Fill"
                        Margin="0,12,0,0" />

                <Button Text="{x:Static resources:AppResources.TransactionDetail_DeleteButton}"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding CanEditOrDelete}"
                        AutomationId="TransactionDetail_DeleteButton"
                        HorizontalOptions="Fill" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
