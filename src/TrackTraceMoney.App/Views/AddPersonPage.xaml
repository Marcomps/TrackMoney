<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.AddPersonPage"
             x:DataType="viewModels:AddPersonViewModel"
             Title="{x:Static resources:AppResources.AddPerson_Title}">

    <Grid RowDefinitions="*,Auto" Padding="16">

        <ScrollView Grid.Row="0">
        <VerticalStackLayout Spacing="12">

            <Label Text="{x:Static resources:AppResources.AddPerson_NameLabel}" />
            <Entry Text="{Binding Name}"
                   AutomationId="AddPerson_NameEntry"
                   Placeholder="{x:Static resources:AppResources.AddPerson_NamePlaceholder}" />

            <Label Text="{x:Static resources:AppResources.AddPerson_RelationshipLabel}" />
            <Picker ItemsSource="{Binding AvailableRelationshipTypes}"
                    SelectedItem="{Binding SelectedRelationshipType}"
                    AutomationId="AddPerson_RelationshipPicker">
                <Picker.ItemDisplayBinding>
                    <Binding Path="." Converter="{StaticResource PersonRelationshipTypeToLabelConverter}" />
                </Picker.ItemDisplayBinding>
            </Picker>

            <VerticalStackLayout IsVisible="{Binding IsCustomRelationship}" Spacing="12">
                <Label Text="{x:Static resources:AppResources.AddPerson_CustomRelationshipLabel}" />
                <Entry Text="{Binding CustomRelationshipLabel}"
                       Placeholder="{x:Static resources:AppResources.AddPerson_CustomRelationshipPlaceholder}" />
            </VerticalStackLayout>

            <Label Text="{x:Static resources:AppResources.AddPerson_NotesLabel}" />
            <Editor Text="{Binding Notes}" HeightRequest="80" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red" />

        </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Spacing="12" Margin="0,12,0,0">
            <Button Text="{x:Static resources:AppResources.AddPerson_SaveButton}"
                    Command="{Binding SaveCommand}"
                    AutomationId="AddPerson_SaveButton"
                    HorizontalOptions="Fill" />

            <Button Text="{x:Static resources:AppResources.AddPerson_CancelButton}"
                    Command="{Binding CancelCommand}"
                    HorizontalOptions="Fill" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
