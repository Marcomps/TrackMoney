<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:models="clr-namespace:TrackTraceMoney.App.Models"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.CategoriesListPage"
             x:DataType="viewModels:CategoriesListViewModel"
             x:Name="Root"
             Title="{x:Static resources:AppResources.Categories_Title}">

    <!-- ScrollView + VerticalStackLayout, not a Grid with a "*" list row: mirrors AccountsListPage's
         same fix for the "wasted space below a short list" issue. -->
    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCategoriesCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="8">

                <HorizontalStackLayout Spacing="8">
                    <Switch IsToggled="{Binding ShowInactive}" AutomationId="CategoriesList_ShowInactiveSwitch" />
                    <Label Text="{x:Static resources:AppResources.CategoriesList_ShowInactiveLabel}" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Label Text="{Binding ErrorMessage}" TextColor="Red" />

                <CollectionView ItemsSource="{Binding Categories}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="24">
                            <Label Text="{x:Static resources:AppResources.Categories_Empty}"
                                   HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:CategoryListItem">
                            <SwipeView>
                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="{x:Static resources:AppResources.CategoriesList_EditAction}"
                                                   IsVisible="{Binding IsActive}"
                                                   Command="{Binding Source={x:Reference Root}, Path=BindingContext.EditCategoryCommand}"
                                                   CommandParameter="{Binding Id}" />
                                        <!-- System-defined categories can never be deactivated/deleted (Category
                                             lifecycle slice §A.2/A-2): CanDeactivateOrDelete hides these
                                             here, not just leaves it to the service-layer throw, so the user
                                             isn't offered an action that will fail. -->
                                        <SwipeItem Text="{x:Static resources:AppResources.CategoriesList_DeactivateAction}"
                                                   IsVisible="{Binding CanDeactivateOrDelete}"
                                                   Command="{Binding Source={x:Reference Root}, Path=BindingContext.DeactivateCategoryCommand}"
                                                   CommandParameter="{Binding Id}" />
                                        <SwipeItem Text="{x:Static resources:AppResources.CategoriesList_DeleteAction}"
                                                   IsVisible="{Binding CanDeactivateOrDelete}"
                                                   BackgroundColor="DarkRed"
                                                   Command="{Binding Source={x:Reference Root}, Path=BindingContext.DeleteCategoryCommand}"
                                                   CommandParameter="{Binding Id}" />
                                        <SwipeItem Text="{x:Static resources:AppResources.CategoriesList_ReactivateAction}"
                                                   IsVisible="{Binding IsInactive}"
                                                   Command="{Binding Source={x:Reference Root}, Path=BindingContext.ReactivateCategoryCommand}"
                                                   CommandParameter="{Binding Id}" />
                                    </SwipeItems>
                                </SwipeView.RightItems>
                                <Grid Padding="0,12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto"
                                      AutomationId="{Binding Name, StringFormat='CategoriesList_Item_{0}'}">
                                    <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                           Text="{Binding Icon}"
                                           IsVisible="{Binding HasIcon}"
                                           FontSize="22" VerticalOptions="Center" Margin="0,0,8,0" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontSize="16" />
                                    <Label Grid.Row="1" Grid.Column="1"
                                           Text="{x:Static resources:AppResources.CategoriesList_InactiveBadge}"
                                           IsVisible="{Binding IsInactive}"
                                           FontSize="12" Opacity="0.6" />
                                    <Label Grid.Row="0" Grid.Column="2"
                                           Text="{x:Static resources:AppResources.Category_SystemLabel}"
                                           IsVisible="{Binding IsSystemDefined}"
                                           FontSize="12" Opacity="0.6"
                                           VerticalOptions="Center" />
                                </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="{x:Static resources:AppResources.Categories_AddButton}"
                        Command="{Binding AddCategoryCommand}"
                        HorizontalOptions="Fill"
                        Margin="0,12,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
