<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:models="clr-namespace:TrackTraceMoney.App.Models"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.CategoriesListPage"
             x:DataType="viewModels:CategoriesListViewModel"
             Title="{x:Static resources:AppResources.Categories_Title}">

    <Grid RowDefinitions="*,Auto" Padding="16">

        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadCategoriesCommand}">
            <CollectionView ItemsSource="{Binding Categories}"
                             SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="24">
                        <Label Text="{x:Static resources:AppResources.Categories_Empty}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:CategoryListItem">
                        <Grid Padding="0,12" ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="{Binding Name}" FontSize="16" />
                            <Label Grid.Column="1"
                                   Text="{x:Static resources:AppResources.Category_SystemLabel}"
                                   IsVisible="{Binding IsSystemDefined}"
                                   FontSize="12" Opacity="0.6"
                                   VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="1"
                Text="{x:Static resources:AppResources.Categories_AddButton}"
                Command="{Binding AddCategoryCommand}"
                HorizontalOptions="Fill"
                Margin="0,12,0,0" />

    </Grid>

</ContentPage>
