<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.RecordCreditCardStatementPage"
             x:DataType="viewModels:RecordCreditCardStatementViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{x:Static resources:AppResources.RecordCreditCardStatement_CycleLabel}" FontAttributes="Bold" />
            <Label>
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding CycleStartDate}" />
                        <Span Text=" - " />
                        <Span Text="{Binding CycleEndDate}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <Label Text="{x:Static resources:AppResources.RecordCreditCardStatement_PurchasesLabel}" />
            <Label Text="{Binding PurchasesThisCycle, StringFormat='{0:N2}'}" />

            <Label Text="{x:Static resources:AppResources.RecordCreditCardStatement_MinimumPaymentLabel}" />
            <Entry Text="{Binding MinimumPaymentText}" Keyboard="Numeric" />

            <Label Text="{x:Static resources:AppResources.RecordCreditCardStatement_PayInFullAmountLabel}" />
            <Entry Text="{Binding PayInFullAmountText}" Keyboard="Numeric" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red" />

            <Button Text="{x:Static resources:AppResources.RecordCreditCardStatement_SaveButton}"
                    Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSave}"
                    HorizontalOptions="Fill" />

            <Button Text="{x:Static resources:AppResources.RecordCreditCardStatement_CancelButton}"
                    Command="{Binding CancelCommand}"
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
