<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.AddTermDepositPage"
             x:DataType="viewModels:AddTermDepositViewModel"
             Title="{x:Static resources:AppResources.AddTermDeposit_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{x:Static resources:AppResources.AddTermDeposit_NameLabel}" />
            <Entry Text="{Binding Name}" />

            <Label Text="{x:Static resources:AppResources.AddTermDeposit_InstitutionLabel}" />
            <Entry Text="{Binding Institution}" />

            <Label Text="{x:Static resources:AppResources.AddTermDeposit_InitialPrincipalLabel}" />
            <Entry Text="{Binding InitialPrincipalText}" Keyboard="Numeric" />

            <Label Text="{x:Static resources:AppResources.AddTermDeposit_OpeningBalanceLabel}" />
            <Entry Text="{Binding OpeningBalanceText}" Keyboard="Numeric" />

            <Label Text="{x:Static resources:AppResources.AddTermDeposit_CurrencyLabel}" />
            <Picker ItemsSource="{Binding AvailableCurrencies}"
                    SelectedItem="{Binding SelectedCurrency}" />

            <Label Text="{x:Static resources:AppResources.AddTermDeposit_RateLabel}" />
            <Entry Text="{Binding RateText}" Keyboard="Numeric" />

            <Label Text="{x:Static resources:AppResources.AddTermDeposit_RateTypeLabel}" />
            <Picker ItemsSource="{Binding AvailableRateTypes}"
                    SelectedItem="{Binding SelectedRateType}">
                <Picker.ItemDisplayBinding>
                    <Binding Path="." Converter="{StaticResource TermDepositRateTypeToLabelConverter}" />
                </Picker.ItemDisplayBinding>
            </Picker>

            <Label Text="{x:Static resources:AppResources.AddTermDeposit_StartDateLabel}" />
            <DatePicker Date="{Binding StartDate}" />

            <Label Text="{x:Static resources:AppResources.AddTermDeposit_MaturityDateLabel}" />
            <DatePicker Date="{Binding MaturityDate}" />

            <Label Text="{x:Static resources:AppResources.AddTermDeposit_InterestFrequencyLabel}" />
            <Picker ItemsSource="{Binding AvailableInterestFrequencies}"
                    SelectedItem="{Binding SelectedInterestFrequency}">
                <Picker.ItemDisplayBinding>
                    <Binding Path="." Converter="{StaticResource TermDepositInterestFrequencyToLabelConverter}" />
                </Picker.ItemDisplayBinding>
            </Picker>

            <HorizontalStackLayout Spacing="8">
                <Label Text="{x:Static resources:AppResources.AddTermDeposit_IsCompoundingLabel}"
                       VerticalOptions="Center" />
                <Switch IsToggled="{Binding IsCompounding}" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <Label Text="{x:Static resources:AppResources.AddTermDeposit_AutoRenewalLabel}"
                       VerticalOptions="Center" />
                <Switch IsToggled="{Binding AutoRenewal}" />
            </HorizontalStackLayout>

            <Label Text="{x:Static resources:AppResources.AddTermDeposit_EstimatedInterestLabel}" />
            <Entry Text="{Binding EstimatedInterestText}" Keyboard="Numeric" />

            <Label Text="{x:Static resources:AppResources.AddTermDeposit_InterestReceivedLabel}" />
            <Entry Text="{Binding InterestReceivedText}" Keyboard="Numeric" />

            <Label Text="{x:Static resources:AppResources.AddTermDeposit_NotesLabel}" />
            <Editor Text="{Binding Notes}" HeightRequest="80" />

            <Label Text="{Binding ErrorMessage}" TextColor="Red" />

            <Button Text="{x:Static resources:AppResources.AddTermDeposit_SaveButton}"
                    Command="{Binding SaveCommand}"
                    HorizontalOptions="Fill" />

            <Button Text="{x:Static resources:AppResources.AddTermDeposit_CancelButton}"
                    Command="{Binding CancelCommand}"
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
