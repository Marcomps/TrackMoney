<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.AddRecurringExpensePage"
             x:DataType="viewModels:AddRecurringExpenseViewModel"
             Title="{x:Static resources:AppResources.AddRecurringExpense_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{x:Static resources:AppResources.AddRecurringExpense_NameLabel}" />
            <Entry Text="{Binding Name}"
                   Placeholder="{x:Static resources:AppResources.AddRecurringExpense_NamePlaceholder}" />

            <Label Text="{x:Static resources:AppResources.AddRecurringExpense_AmountLabel}" />
            <Entry Text="{Binding AmountText}" Keyboard="Numeric" />

            <Label Text="{x:Static resources:AppResources.AddRecurringExpense_CategoryLabel}" />
            <Picker ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />

            <Label Text="{x:Static resources:AppResources.AddRecurringExpense_AccountLabel}" />
            <Picker ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" />

            <Label Text="{x:Static resources:AppResources.AddRecurringExpense_FrequencyLabel}" />
            <Picker ItemsSource="{Binding AvailableFrequencies}"
                    SelectedItem="{Binding SelectedFrequency}">
                <Picker.ItemDisplayBinding>
                    <Binding Path="." Converter="{StaticResource RecurringExpenseFrequencyToLabelConverter}" />
                </Picker.ItemDisplayBinding>
            </Picker>

            <Label Text="{x:Static resources:AppResources.AddRecurringExpense_StartDateLabel}" />
            <DatePicker Date="{Binding StartDate}" />

            <HorizontalStackLayout Spacing="8">
                <Label Text="{x:Static resources:AppResources.AddRecurringExpense_HasEndDateLabel}"
                       VerticalOptions="Center" />
                <Switch IsToggled="{Binding HasEndDate}" />
            </HorizontalStackLayout>

            <VerticalStackLayout IsVisible="{Binding HasEndDate}" Spacing="12">
                <Label Text="{x:Static resources:AppResources.AddRecurringExpense_EndDateLabel}" />
                <DatePicker Date="{Binding EndDate}" />
            </VerticalStackLayout>

            <Label Text="{Binding ErrorMessage}" TextColor="Red" />

            <Button Text="{x:Static resources:AppResources.AddRecurringExpense_SaveButton}"
                    Command="{Binding SaveCommand}"
                    HorizontalOptions="Fill" />

            <Button Text="{x:Static resources:AppResources.AddRecurringExpense_CancelButton}"
                    Command="{Binding CancelCommand}"
                    HorizontalOptions="Fill" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
