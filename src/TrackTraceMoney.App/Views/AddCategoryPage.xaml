<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.AddCategoryPage"
             x:DataType="viewModels:AddCategoryViewModel"
             Title="{x:Static resources:AppResources.AddCategory_Title}">

    <Grid RowDefinitions="*,Auto" Padding="16">

        <ScrollView Grid.Row="0">
        <VerticalStackLayout Spacing="12">

            <Label Text="{x:Static resources:AppResources.AddCategory_NameLabel}" />
            <Entry Text="{Binding Name}"
                   Placeholder="{x:Static resources:AppResources.AddCategory_NamePlaceholder}"
                   AutomationId="AddCategory_NameEntry" />

            <Label Text="{x:Static resources:AppResources.AddCategory_IconLabel}" />
            <Picker ItemsSource="{Binding AvailableIcons}"
                    SelectedItem="{Binding SelectedIcon}"
                    AutomationId="AddCategory_IconPicker">
                <Picker.ItemDisplayBinding>
                    <Binding Path="." Converter="{StaticResource CategoryIconToDisplayConverter}" />
                </Picker.ItemDisplayBinding>
            </Picker>

            <Label Text="{Binding ErrorMessage}" TextColor="Red" />

        </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Spacing="12" Margin="0,12,0,0">
            <Button Text="{x:Static resources:AppResources.AddCategory_SaveButton}"
                    Command="{Binding SaveCommand}"
                    AutomationId="AddCategory_SaveButton"
                    HorizontalOptions="Fill" />

            <Button Text="{x:Static resources:AppResources.AddCategory_CancelButton}"
                    Command="{Binding CancelCommand}"
                    AutomationId="AddCategory_CancelButton"
                    HorizontalOptions="Fill" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
