<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:models="clr-namespace:TrackTraceMoney.App.Models"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.SnowballPlanPage"
             x:DataType="viewModels:SnowballPlanViewModel"
             x:Name="Root"
             Title="{x:Static resources:AppResources.SnowballPlan_Title}">

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding LoadSnowballPlanCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- How it works, up front: the plan is only useful if the ordering makes sense to the user. -->
                <Border Style="{StaticResource GlossyCardStyle}" Padding="16,14">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{x:Static resources:AppResources.SnowballPlan_HowItWorksTitle}"
                               FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        <Label Text="{x:Static resources:AppResources.SnowballPlan_HowItWorksStep1}" FontSize="14" />
                        <Label Text="{x:Static resources:AppResources.SnowballPlan_HowItWorksStep2}" FontSize="14" />
                        <Label Text="{x:Static resources:AppResources.SnowballPlan_HowItWorksStep3}" FontSize="14" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{x:Static resources:AppResources.SnowballPlan_Empty}"
                       IsVisible="{Binding IsEmpty}"
                       HorizontalTextAlignment="Center" />

                <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding Groups}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:SnowballCurrencyGroupItem">
                            <Border Style="{StaticResource GlossyCardStyle}" Padding="16,14">
                                <VerticalStackLayout Spacing="8">

                                    <Label Text="{Binding Currency}" FontAttributes="Bold" FontSize="16" />

                                    <Label Text="{x:Static resources:AppResources.SnowballPlan_ExtraLabel}" FontSize="14" />
                                    <Entry Text="{Binding ExtraAvailableText}" Keyboard="Numeric"
                                           AutomationId="{Binding Currency, StringFormat='SnowballPlan_ExtraEntry_{0}'}" />

                                    <!-- The two numbers that matter most: this month's total and the finish line. -->
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding PayThisMonthText}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}"
                                               AutomationId="{Binding Currency, StringFormat='SnowballPlan_PayThisMonth_{0}'}" />
                                        <Label Text="{Binding PayThisMonthBreakdownText}" FontSize="13" Opacity="0.8" />
                                        <Label Text="{Binding DebtFreeText}" FontSize="15" FontAttributes="Bold" Margin="0,6,0,0"
                                               AutomationId="{Binding Currency, StringFormat='SnowballPlan_DebtFree_{0}'}" />
                                    </VerticalStackLayout>

                                    <Label Text="{x:Static resources:AppResources.SnowballPlan_OrderTitle}"
                                           FontSize="15" FontAttributes="Bold" Margin="0,8,0,0" />

                                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Lines}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:SnowballDebtLineItem">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto"
                                                      AutomationId="{Binding Name, StringFormat='SnowballPlan_Line_{0}'}">
                                                    <Label Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Text="{Binding Position}"
                                                           FontSize="22" FontAttributes="Bold" TextColor="{StaticResource Primary}" VerticalOptions="Start" />
                                                    <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto">
                                                        <Label Grid.Column="0" Text="{Binding DisplayName}" FontSize="16" FontAttributes="Bold" />
                                                        <Label Grid.Column="1" Text="{Binding OwedText}" FontSize="14" />
                                                    </Grid>
                                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding PaymentText}" FontSize="14" />
                                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding PayoffText}" FontSize="13" Opacity="0.8" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Label Text="{Binding NextTargetAdvisoryMessage}"
                                           IsVisible="{Binding ShowNextTargetAdvisory}"
                                           FontSize="12" Opacity="0.8" />

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasExcludedCards}">
                    <Label Text="{x:Static resources:AppResources.SnowballPlan_ExcludedCardsHeader}" FontAttributes="Bold" />

                    <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding ExcludedCards}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ExcludedCardListItem">
                                <Border Padding="12" Margin="0,4" StrokeShape="RoundRectangle 8">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference Root}, Path=BindingContext.RecordStatementForExcludedCardCommand}"
                                            CommandParameter="{Binding Id}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Text="{Binding AmountOwed, StringFormat='{0:N2}'}" FontSize="12" Opacity="0.7" />
                                        <Label Text="{x:Static resources:AppResources.SnowballPlan_ExcludedCardsHint}" FontSize="12" Opacity="0.7" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Label Text="{x:Static resources:AppResources.SnowballPlan_EstimateNote}"
                       FontSize="12" Opacity="0.7" Margin="0,12,0,0" />

                <Label Text="{x:Static resources:AppResources.SnowballPlan_AdvisoryNote}"
                       FontSize="12" Opacity="0.7" Margin="0,12,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>
