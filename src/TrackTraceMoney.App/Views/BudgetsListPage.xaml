<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:models="clr-namespace:TrackTraceMoney.App.Models"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.BudgetsListPage"
             x:DataType="viewModels:BudgetsListViewModel"
             Title="{x:Static resources:AppResources.Budgets_Title}">

    <Grid RowDefinitions="*,Auto" Padding="16">

        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadBudgetsCommand}">
            <CollectionView ItemsSource="{Binding Budgets}"
                             SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="24">
                        <Label Text="{x:Static resources:AppResources.Budgets_Empty}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BudgetListItem">
                        <Grid Padding="0,12" ColumnDefinitions="Auto,*,Auto">
                            <Label Grid.Column="0" Text="{Binding SemaforoEmoji}" FontSize="16" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding CategoryName}" FontSize="16"
                                   Margin="8,0,0,0" VerticalOptions="Center" />
                            <Label Grid.Column="2" VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Spent, StringFormat='{0:N2}'}" />
                                        <Span Text=" / " />
                                        <Span Text="{Binding BudgetAmount, StringFormat='{0:N2}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="1"
                Text="{x:Static resources:AppResources.Budgets_AddButton}"
                Command="{Binding AddBudgetCommand}"
                HorizontalOptions="Fill"
                Margin="0,12,0,0" />

    </Grid>

</ContentPage>
