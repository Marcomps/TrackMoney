<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:TrackTraceMoney.App.ViewModels"
             xmlns:models="clr-namespace:TrackTraceMoney.App.Models"
             xmlns:resources="clr-namespace:TrackTraceMoney.App.Resources.Strings"
             x:Class="TrackTraceMoney.App.Views.BudgetsListPage"
             x:DataType="viewModels:BudgetsListViewModel"
             x:Name="Root"
             Title="{x:Static resources:AppResources.Budgets_Title}">

    <Grid RowDefinitions="*,Auto" Padding="16">

        <RefreshView Grid.Row="0"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding LoadBudgetsCommand}">
            <CollectionView ItemsSource="{Binding Budgets}"
                             SelectionMode="None">
                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Padding="24">
                        <Label Text="{x:Static resources:AppResources.Budgets_Empty}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BudgetListItem">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="{x:Static resources:AppResources.Budgets_EditAction}"
                                               Command="{Binding Source={x:Reference Root}, Path=BindingContext.EditBudgetCommand}"
                                               CommandParameter="{Binding Id}" />
                                    <SwipeItem Text="{x:Static resources:AppResources.Budgets_DeleteAction}"
                                               BackgroundColor="DarkRed"
                                               Command="{Binding Source={x:Reference Root}, Path=BindingContext.DeleteBudgetCommand}"
                                               CommandParameter="{Binding Id}" />
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Grid Padding="0,12" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding SemaforoEmoji}" FontSize="16" VerticalOptions="Center" />
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding CategoryName}" FontSize="16"
                                       Margin="8,0,0,0" VerticalOptions="Center" />
                                <Label Grid.Row="0" Grid.Column="2" VerticalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static resources:AppResources.Budgets_SpentLabel}" />
                                            <Span Text=": " />
                                            <Span Text="{Binding Spent, StringFormat='{0:N2}'}" />
                                            <Span Text=" " />
                                            <Span Text="{x:Static resources:AppResources.Budgets_OfLabel}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding BudgetAmount, StringFormat='{0:N2}'}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding Currency}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                       Margin="8,2,0,0" FontSize="13" Opacity="0.85">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{x:Static resources:AppResources.Budgets_RemainingLabel}" />
                                            <Span Text=": " />
                                            <Span Text="{Binding Remaining, StringFormat='{0:N2}'}" />
                                            <Span Text=" " />
                                            <Span Text="{Binding Currency}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="1"
                Text="{x:Static resources:AppResources.Budgets_AddButton}"
                Command="{Binding AddBudgetCommand}"
                HorizontalOptions="Fill"
                Margin="0,12,0,0" />

    </Grid>

</ContentPage>
